<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="32dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardElevation="8dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 标题 -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="备份选项"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- 本地备份 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLocalBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="本地备份"
            android:textColor="?attr/colorPrimary"
            app:cornerRadius="16dp"
            android:minHeight="44dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginVertical="16dp" />

        <!-- WebDAV 备份标题 -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WebDAV 备份"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- 服务器地址 -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="服务器地址"
            app:boxBackgroundMode="outline"
            app:hintTextColor="?attr/colorOnSurface"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dialogWebdavUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurface" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 用户名 -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="用户名"
            app:boxBackgroundMode="outline"
            app:hintTextColor="?attr/colorOnSurface"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dialogWebdavUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurface" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 密码 -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="密码"
            app:boxBackgroundMode="outline"
            app:hintTextColor="?attr/colorOnSurface"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dialogWebdavPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurface" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 操作按钮行 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialogWebdavLink"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="注册开通"
                android:textColor="?attr/colorPrimary"
                app:cornerRadius="16dp"
                android:minHeight="44dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialogWebdavSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="保存配置"
                android:textColor="?attr/colorPrimary"
                app:cornerRadius="16dp"
                android:minHeight="44dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialogWebdavTest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="测试连接"
                android:textColor="?attr/colorPrimary"
                app:cornerRadius="16dp"
                android:minHeight="44dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 文件操作行 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialogWebdavUpload"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="上传备份"
                android:textColor="?attr/colorPrimary"
                app:cornerRadius="16dp"
                android:minHeight="44dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialogWebdavList"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="查看文件"
                android:textColor="?attr/colorPrimary"
                app:cornerRadius="16dp"
                android:minHeight="44dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialogWebdavDownload"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="下载备份"
                android:textColor="?attr/colorPrimary"
                app:cornerRadius="16dp"
                android:minHeight="44dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 状态提示 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/dialogWebdavStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:gravity="center" />

        <!-- 关闭按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialogClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="关闭"
            android:textColor="?attr/colorOnSurface"
            android:minHeight="44dp"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</com.google.android.material.card.MaterialCardView>
