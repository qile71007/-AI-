<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="生成私密配置JSON工具"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <EditText
        android:id="@+id/et_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="输入源名称"
        android:layout_marginTop="12dp"
        android:singleLine="true"/>

    <EditText
        android:id="@+id/et_url_plain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="输入enc-url对应的明文播放地址"
        android:layout_marginTop="10dp"
        android:minLines="2"/>

    <EditText
        android:id="@+id/et_key_plain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="输入enc-keyword对应的明文关键词"
        android:layout_marginTop="10dp"
        android:singleLine="true"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_generate_json"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="生成私密配置JSON"/>

        <Button
            android:id="@+id/btn_copy_json"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="复制JSON文本"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="生成结果JSON："
        android:layout_marginTop="12dp"/>

    <TextView
        android:id="@+id/tv_json_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#222222"
        android:textSize="13sp"
        android:maxLines="10"
        android:scrollbars="vertical"/>
</LinearLayout>